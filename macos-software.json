  "package_managers": {
    "homebrew": {
      "name": "Homebrew",
      "description": "Пакетный менеджер для macOS",
      "install_command": "brew install",
      "cask_command": "brew install --cask",
      "check_command": "brew --version",
      "install_script": "/bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"",
      "available_by_default": false
    },
    "app_store": {
      "name": "Mac App Store",
      "description": "Официальный магазин приложений Apple",
      "install_command": "mas install",
      "check_command": "mas version",
      "install_mas": "brew install mas",
      "available_by_default": true,
      "note": "Требует Apple ID для установки приложений"
    }
